# ===========================================================================
# seed-ssm.env.example — template for the seed-ssm.sh inputs (IRD-019).
#
# Copy to ~/.proops-secrets.env (OUTSIDE the repo, gitignored) and fill in.
# Leave a password BLANK to have seed-ssm.sh generate it (openssl rand).
# NEVER put real values here — this file IS committed. Real values go ONLY in
# ~/.proops-secrets.env. The only human-held root of trust is your AWS SSO.
#   cp scripts/seed-ssm.env.example ~/.proops-secrets.env && chmod 600 ~/.proops-secrets.env
# ===========================================================================

# --- Must be supplied (external systems; cannot be generated) ---------------
DISCORD_WEBHOOK_URL="change_me"      # Alertmanager + Agent A receiver
SONAR_TOKEN="change_me"             # CI SonarCloud token (read via OIDC gha-ssm-read)

# --- Optional: leave blank to auto-generate (openssl rand -base64 24) --------
MYSQL_ROOT_PASSWORD=""
MYSQL_USER_SVC_PASSWORD=""
MYSQL_TASK_SVC_PASSWORD=""
MYSQL_NOTIF_SVC_PASSWORD=""
REDIS_PASSWORD=""
GRAFANA_ADMIN_PASSWORD=""

# --- Optional: reuse the D6 RS256 private key instead of generating a new one -
# If set, seed-ssm.sh derives the public key from it. Leave blank to generate.
JWT_PRIVATE_KEY_FILE=""
