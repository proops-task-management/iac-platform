# Managed by Ansible (k3s-server role) — k3s reads this at /etc/rancher/k3s/config.yaml.
# Server flags live HERE (templated), not in a long INSTALL_K3S_EXEC string (P1-5).
# tls-san carries the STABLE DNS names (k8s.<domain>, <domain>, argocd.<domain>) + the
# server's private IP, so kubectl/Argo over the named endpoint passes the cert SAN check
# (P0-2b). The runtime PUBLIC IP is deliberately NOT a SAN (MIN-54): it changes on every
# stop/start, which re-rendered this file daily and restarted k3s (DOP-010 AC-10-17).
# Traefik + servicelb stay ENABLED (IRD-016).
write-kubeconfig-mode: "0644"
tls-san:
{% for san in k3s_tls_san %}
  - "{{ san }}"
{% endfor %}
node-label:
  - "node-role.proops/server=true"
