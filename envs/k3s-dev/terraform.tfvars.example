# Copy to terraform.tfvars (gitignored) and override only what changes.
# All keys have sensible defaults in variables.tf, so an EMPTY terraform.tfvars
# is valid.
#
# There is no admin_cidr any more (MIN-50 / ADR-017): the k3s API has no public
# ingress, and operator kubectl goes through an SSM port-forward
# (scripts/k8s-tunnel.sh). Nothing about your own IP is an input to this root.

# instance_type    = "t3.medium"    # amd64 (x86_64), 2 vCPU / 4 GiB — MUST stay amd64 (ADR-015)
# root_volume_gb   = 20
# enable_auto_stop = true           # nightly stop 23:00 ICT
